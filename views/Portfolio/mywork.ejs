<% layout("/Boilerplate/boilerplate.ejs")%>
<section class="flex flex-col items-center p-6 gap-4">
  <div class="text-center">

    <h1 class="text-3xl font-bold text-gray-900">
      My <span class="text-orange-500">Development Work</span>
    </h1>

    <p class="text-gray-600">
      Diverse Range of Projects from desktop to web Applications
    </p>

  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 px-6 py-10 w-full max-w-7xl">

    <% projectData.forEach((project) => { %>

      <div
        class="reveal group flex flex-col justify-between p-7 bg-white rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-gray-100 hover:shadow-[0_8px_30px_rgb(250,105,32,0.1)] hover:border-orange-100 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
      >
        <!-- Top decorative line on hover -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-orange-400 to-[#FA6920] transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>

        <!-- Top badges -->
        <div class="flex justify-between items-center mb-5">
          <div class="flex gap-2">
            <% if(project.liveLink) { %>
              <span class="bg-orange-50 text-orange-600 ring-1 ring-orange-500/20 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
                Live
              </span>
            <% } else { %>
              <span class="bg-gray-50 text-gray-500 ring-1 ring-gray-500/20 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                Offline
              </span>
            <% } %>
          </div>
          <span class="text-gray-400 text-sm group-hover:text-orange-500 transition-colors">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </span>
        </div>

        <!-- Content -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-orange-500 transition-colors line-clamp-2">
            <%= project.title %>
          </h2>

          <p class="text-sm text-gray-500 mb-6 leading-relaxed line-clamp-3">
            <%= project.description %>
          </p>
        </div>

        <!-- Tech Stack -->
        <div class="flex flex-wrap gap-2 mb-8">
          <% project.techStack.slice(0, 4).forEach((tech) => { %>
            <span class="bg-gray-50 text-gray-600 border border-gray-100 text-[11px] font-medium px-3 py-1 rounded-full">
              <%= tech %>
            </span>
          <% }) %>
          <% if(project.techStack.length > 4) { %>
            <span class="bg-gray-50 text-gray-600 border border-gray-100 text-[11px] font-medium px-2 py-1 rounded-full">
              +<%= project.techStack.length - 4 %>
            </span>
          <% } %>
        </div>

        <!-- Buttons -->
        <div class="flex items-center justify-between gap-3 mt-auto pt-4 border-t border-gray-50">
          <div class="flex gap-2">
            <a
              href="<%= project.liveLink %>"
              target="_blank"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-gray-200 text-gray-700 hover:text-orange-500 hover:border-orange-500 hover:bg-orange-50 transition-all"
              title="Live Preview"
            >
              <i class="fa-solid fa-globe"></i>
            </a>

            <a
              href="<%= project.githubLink %>"
              target="_blank"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-900 text-white hover:bg-orange-500 transition-all shadow-sm"
              title="Source Code"
            >
              <i class="fa-brands fa-github text-lg"></i>
            </a>
          </div>

          <a
            href="/mywork/<%= project._id %>"
            class="text-sm font-semibold text-gray-700 hover:text-orange-500 flex items-center gap-1.5 group/link transition-colors"
          >
            Details 
            <i class="fa-solid fa-arrow-right text-xs transform group-hover/link:translate-x-1 transition-transform"></i>
          </a>
        </div>

      </div>

    <% }) %>

  </div>

</section>
